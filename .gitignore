# server control state (PID file and log)
.server/

# render jobs, uploaded clips and project state: machine-specific, large, regenerable
runs/

# the desktop app's own data directory: project state plus the clips the user opened with it.
# Measured 1.38 GB over 18 files (782 MB, 217 MB, 208 MB and 174 MB of footage), so it is the same
# category as `runs/` and for the same three reasons -- large, machine-specific, and it holds the
# user's own material rather than anything this repository produces.
.vml_data/

# generated analysis and contact sheets
tools/out/
tools/ref*/
tools/seq*/
tools/scan*/

# snapshots taken during recovery (superseded by git itself)
tools/_snapshot*.zip
tools/_snapshot*.py

# python
__pycache__/
*.py[cod]
.venv/
venv/

# editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# agent hand-off bundles (compressed copies of this repository: not source, and large)
_agent_upload/
*.zip
